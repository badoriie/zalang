{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(node --test*)",
      "Bash(npx tsc*)",
      "Bash(npx prettier*)",
      "Bash(npx eslint*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh pr view*)"
    ],
    "deny": ["Bash(rm -rf *)", "Read(./.env*)", "Read(./.chrome-debug/**)"],
    "ask": ["Bash(git push --force*)", "Bash(git push -f*)", "Bash(git reset --hard*)"]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/deny-dist-edit.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/scan-staged-secrets.sh\"",
            "timeout": 20,
            "statusMessage": "Scanning staged changes for keys..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-main-branch.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-main-branch.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push)",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-main-branch.sh\"",
            "timeout": 10
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.sh\"",
            "timeout": 30
          }
        ]
      }
    ],

    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-gate.sh\"",
            "timeout": 120,
            "statusMessage": "Typechecking..."
          }
        ]
      }
    ]
  },

  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },

  "env": {
    "ENABLE_LSP_TOOL": "1"
  }
}
